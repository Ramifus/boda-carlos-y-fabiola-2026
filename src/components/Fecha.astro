---
// ComponenteFecha.astro
---

<section class="relative w-full py-6 px-6 overflow-x-clip">

    <div class="relative z-10 max-w-xl mx-auto flex flex-col items-center text-center">

        <!-- Título "Nos Casamos" con líneas laterales -->
        <div id="titulo-nos-casamos" class="flex items-center justify-center gap-4 mb-8">
            <span class="block w-10 sm:w-14 h-px bg-gradient-to-r from-transparent to-[#C9A961]/70"></span>
            <h2 class="font-serif font-light text-[#C9A961] text-base sm:text-lg md:text-xl tracking-[0.4em] uppercase whitespace-nowrap">
                Nos Casamos
            </h2>
            <span class="block w-10 sm:w-14 h-px bg-gradient-to-l from-transparent to-[#C9A961]/70"></span>
        </div>

        <!-- Año arriba, centrado -->
        <div id="anio" class="font-serif font-light text-[#7A7A7A] text-sm sm:text-base tracking-[0.4em] mb-3">
            2026
        </div>

        <!-- Fecha enmarcada con líneas finas arriba y abajo -->
        <div class="flex items-center justify-center w-full py-5 border-t border-b border-[#C9A961]/40">

            <!-- Día de la semana -->
            <div id="dia-semana" class="flex-1 basis-0 flex justify-end pr-4 sm:pr-6">
                <span class="font-serif font-light text-[#7A7A7A] text-base sm:text-lg md:text-xl uppercase">
                    Sábado
                </span>
            </div>

            <!-- Separador vertical -->
            <div class="w-px self-stretch bg-[#C9A961]/30"></div>

            <!-- Día -->
            <div id="dia-numero" class="flex items-center justify-center px-4 sm:px-6">
                <span class="font-serif text-[#7A7A7A] text-5xl sm:text-6xl md:text-7xl font-light leading-none">
                    28
                </span>
            </div>

            <!-- Separador vertical -->
            <div class="w-px self-stretch bg-[#C9A961]/30"></div>

            <!-- Mes -->
            <div id="mes-anio" class="flex-1 basis-0 flex justify-start pl-4 sm:pl-6">
                <span class="font-serif font-light text-[#7A7A7A] text-base sm:text-lg md:text-xl uppercase">
                    Noviembre
                </span>
            </div>

        </div>

    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        console.log("🎊 Iniciando animaciones de fecha...");

        // ═══ TÍTULO "¡NOS CASAMOS!" ═══
        gsap.fromTo(
            "#titulo-nos-casamos",
            { opacity: 0, y: -30 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#titulo-nos-casamos",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                }
            }
        );

        // ═══ AÑO (2026) ═══
        gsap.fromTo(
            "#anio",
            { opacity: 0, y: -15 },
            {
                opacity: 1,
                y: 0,
                duration: 0.7,
                ease: "power2.out",
                delay: 0.2,
                scrollTrigger: {
                    trigger: "#dia-numero",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                }
            }
        );

        // ═══ DÍA DE LA SEMANA ═══
        gsap.fromTo(
            "#dia-semana",
            { opacity: 0, x: -30 },
            {
                opacity: 1,
                x: 0,
                duration: 0.8,
                ease: "power2.out",
                delay: 0.4,
                scrollTrigger: {
                    trigger: "#dia-numero",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                }
            }
        );

        // ═══ DÍA (número) ═══
        gsap.fromTo(
            "#dia-numero",
            { opacity: 0, scale: 0.5, rotation: -10 },
            {
                opacity: 1,
                scale: 1,
                rotation: 0,
                duration: 1,
                ease: "back.out(1.7)",
                delay: 0.3,
                scrollTrigger: {
                    trigger: "#dia-numero",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                }
            }
        );

        // ═══ MES Y AÑO ═══
        gsap.fromTo(
            "#mes-anio",
            { opacity: 0, x: 50 },
            {
                opacity: 1,
                x: 0,
                duration: 0.8,
                ease: "power2.out",
                delay: 0.6,
                scrollTrigger: {
                    trigger: "#mes-anio",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                }
            }
        );

        console.log("✨ Animaciones de fecha completadas!");
    });
</script>

<style>
    /* Transiciones suaves */
    section * {
        transition: all 0.3s ease;
    }

    /* Efecto hover en el día */
    #dia-numero:hover {
        transform: scale(1.05);
        cursor: default;
    }

    /* Efecto hover en mes */
    #mes-anio:hover {
        transform: translateX(5px);
        cursor: default;
    }
</style>
