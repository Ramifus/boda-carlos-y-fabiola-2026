---
// Portada.astro
---

<section id="portada-bienvenida" class="fixed inset-0 w-full h-screen z-50 flex items-center justify-center overflow-hidden bg-gradient-to-br from-[#f8f6f2] via-[#f5f3f0] to-[#ece5db]">

    <!-- Viñeta sutil para dar profundidad -->
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_55%,rgba(120,110,95,0.12)_100%)]"></div>

    <!-- Esquinas decorativas doradas -->
    <div class="esquina-deco absolute top-5 left-5 sm:top-7 sm:left-7 w-12 h-12 border-t border-l border-[#C9A961]/60"></div>
    <div class="esquina-deco absolute top-5 right-5 sm:top-7 sm:right-7 w-12 h-12 border-t border-r border-[#C9A961]/60"></div>
    <div class="esquina-deco absolute bottom-5 left-5 sm:bottom-7 sm:left-7 w-12 h-12 border-b border-l border-[#C9A961]/60"></div>
    <div class="esquina-deco absolute bottom-5 right-5 sm:bottom-7 sm:right-7 w-12 h-12 border-b border-r border-[#C9A961]/60"></div>

    <!-- Decoración superior izquierda - Flores Arriba -->
    <div class="absolute top-0 left-0 w-80 md:w-64 lg:w-72 opacity-90 animate-fade-in-down">
        <img src="/imagenes/FloresArriba.webp" alt="Flores decorativas" class="w-full h-auto" />
    </div>

    <!-- Decoración inferior derecha - Flores Abajo -->
    <div class="absolute bottom-0 right-0 w-80 md:w-64 lg:w-72 opacity-90 animate-fade-in-up">
        <img src="/imagenes/FloresAbajo.webp" alt="Flores decorativas" class="w-full h-auto" />
    </div>

    <!-- Contenido principal -->
    <div class="relative z-10 flex flex-col items-center justify-center px-6 py-8 w-full max-w-md">

        <!-- Línea superior elegante -->
        <p id="portada-overline" class="font-serif text-[#C9A961] text-base sm:text-lg tracking-[0.4em] uppercase mb-1 text-center">
            Nuestra Boda
        </p>

        <!-- Marco con flores y nombres -->
        <div id="contenedor-principal" class="relative w-full flex justify-center items-center">
            
            <!-- Imagen del marco con flores (FloresCentro.webp) -->
            <div class="relative w-72 h-96 sm:w-80 sm:h-[28rem] md:w-96 md:h-[32rem]">
                <img
                    id="marco-flores"
                    src="/imagenes/FloresCentro.webp"
                    alt="Marco decorativo"
                    class="w-full h-full object-contain"
                />
                
                <!-- Nombres de los novios DENTRO del marco -->
                <div class="absolute inset-0 flex flex-col items-center justify-center px-8">
                    <h2 id="nombre-john" class="font-great-vibes text-5xl sm:text-6xl md:text-7xl text-[#8b8b8b] tracking-wide text-center">
                        Carlos
                    </h2>
                    
                    <div id="ampersand" class="flex items-center gap-3 my-3">
                        <div class="w-12 h-px bg-gradient-to-r from-transparent to-[#C9A961]/70"></div>
                        <span class="text-[#C9A961] text-3xl sm:text-4xl font-charm italic">y</span>
                        <div class="w-12 h-px bg-gradient-to-l from-transparent to-[#C9A961]/70"></div>
                    </div>
                    
                    <h2 id="nombre-damarys" class="font-great-vibes text-5xl sm:text-6xl md:text-7xl text-[#8b8b8b] tracking-wide text-center">
                        Fabiola
                    </h2>
                </div>
            </div>

        </div>

        <!-- Botón INGRESAR -->
        <div class="mt-8 flex justify-center">
            <button
                id="btn-ingresar"
                class="group relative px-12 py-3.5 bg-[#8b9677] hover:bg-[#7a8566] text-white font-serif text-sm md:text-base uppercase tracking-[0.3em] rounded-md shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-0.5"
            >
                <!-- Borde interior fino (detalle elegante) -->
                <span class="pointer-events-none absolute inset-1.5 rounded-[3px] border border-white/40 transition-all duration-300 group-hover:inset-[7px]"></span>

                <span class="relative z-10">Ingresar</span>
            </button>
        </div>

        <!-- Fecha elegante -->
        <div id="portada-fecha" class="mt-7 flex items-center justify-center gap-2 text-[#9a9a9a]">
            <span class="w-8 h-px bg-[#C9A961]/60"></span>
            <span class="font-serif text-sm sm:text-base tracking-[0.2em] uppercase whitespace-nowrap text-center">28 · Noviembre · 2026</span>
            <span class="w-8 h-px bg-[#C9A961]/60"></span>
        </div>

    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener('DOMContentLoaded', () => {
        console.log("💐 Iniciando animaciones de portada...");

        // ═══ ESQUINAS DECORATIVAS - Fade in suave ═══
        gsap.fromTo(
            ".esquina-deco",
            { opacity: 0, scale: 0.6 },
            { opacity: 1, scale: 1, duration: 1, ease: "power2.out", stagger: 0, delay: 0.1 }
        );

        // ═══ LÍNEA SUPERIOR "Nuestra Boda" ═══
        gsap.fromTo(
            "#portada-overline",
            { opacity: 0, y: -20, letterSpacing: "0.7em" },
            { opacity: 1, y: 0, letterSpacing: "0.4em", duration: 1, ease: "power2.out", delay: 0.1 }
        );

        // ═══ MARCO CON FLORES - Aparece suave, de desenfocado a nítido ═══
        gsap.fromTo(
            "#marco-flores",
            { opacity: 0, scale: 0.94, filter: "blur(6px)" },
            {
                opacity: 1,
                scale: 1,
                filter: "blur(0px)",
                duration: 1.3,
                ease: "power3.out",
                delay: 0.1,
                onComplete: () => gsap.set("#marco-flores", { clearProps: "filter" })
            }
        );

        // ═══ BALANCEO MUY SUTIL DEL MARCO (loop infinito) ═══
        gsap.fromTo("#marco-flores",
            { rotation: -1 },
            {
                rotation: 1,
                duration: 5,
                ease: "sine.inOut",
                yoyo: true,
                repeat: -1,
                delay: 1.4
            }
        );

        // ═══ NOMBRE JOHN - Letra por letra ═══
        const textoJohn = "Carlos";
        const contenedorJohn = document.getElementById("nombre-john");
        if (contenedorJohn) {
            contenedorJohn.innerHTML = textoJohn
                .split("")
                .map(
                    (letra) =>
                        `<span class="letra-animada" style="
                            opacity: 0; 
                            display: inline-block; 
                            transform: translateY(20px) scale(0.8);
                            filter: blur(3px);
                        ">${letra === " " ? "&nbsp;" : letra}</span>`
                )
                .join("");

            gsap.to("#nombre-john .letra-animada", {
                opacity: 1,
                y: 0,
                scale: 1,
                filter: "blur(0px)",
                duration: 0.5,
                ease: "power2.out",
                stagger: { each: 0.03, from: "start" },
                delay: 0.1
            });
        }

        // ═══ SÍMBOLO Y con líneas - Scale con bounce ═══
        gsap.fromTo(
            "#ampersand",
            { opacity: 0, scale: 0.5 },
            { opacity: 1, scale: 1, duration: 0.6, ease: "back.out(2)", delay: 0.1 }
        );

        // ═══ NOMBRE DAMARYS - Letra por letra ═══
        const textoDamarys = "Fabiola";
        const contenedorDamarys = document.getElementById("nombre-damarys");
        if (contenedorDamarys) {
            contenedorDamarys.innerHTML = textoDamarys
                .split("")
                .map(
                    (letra) =>
                        `<span class="letra-animada" style="
                            opacity: 0; 
                            display: inline-block; 
                            transform: translateY(20px) scale(0.8);
                            filter: blur(3px);
                        ">${letra === " " ? "&nbsp;" : letra}</span>`
                )
                .join("");

            gsap.to("#nombre-damarys .letra-animada", {
                opacity: 1,
                y: 0,
                scale: 1,
                filter: "blur(0px)",
                duration: 0.5,
                ease: "power2.out",
                stagger: { each: 0.03, from: "start" },
                delay: 0.1
            });
        }

        // ═══ BOTÓN INGRESAR CON FUNCIONALIDAD ═══
        const btnIngresar = document.getElementById('btn-ingresar');
        const portada = document.getElementById('portada-bienvenida');

        // Animación de entrada del botón
        gsap.fromTo(
            "#btn-ingresar",
            { opacity: 0, y: 30, scale: 0.9 },
            { opacity: 1, y: 0, scale: 1, duration: 0.6, ease: "back.out(1.5)", delay: 0.1 }
        );

        // ═══ FECHA ELEGANTE ═══
        gsap.fromTo(
            "#portada-fecha",
            { opacity: 0, y: 20 },
            { opacity: 1, y: 0, duration: 0.8, ease: "power2.out", delay: 0.1 }
        );

        btnIngresar?.addEventListener('click', () => {
            console.log("🚪 Cerrando portada...");

            // 🎵 Iniciar la música SOLO ahora, al presionar Ingresar
            window.dispatchEvent(new CustomEvent('iniciar-musica'));

            // Liberar el scroll YA, sin esperar a que termine el fundido:
            // si no, el primer deslizamiento cae sobre la portada y se pierde
            window.scrollTo(0, 0);
            portada?.classList.add('cerrando');

            // ═══ DESTELLO DORADO al abrir la invitación ═══
            // Nace en el botón, ilumina la pantalla y se disuelve mostrando
            // la foto y los nombres que estaban detrás.
            const rect = btnIngresar.getBoundingClientRect();
            const cx = rect.left + rect.width / 2;
            const cy = rect.top + rect.height / 2;

            const destello = document.createElement('div');
            destello.className = 'destello-portada';
            destello.style.background = `radial-gradient(circle at ${cx}px ${cy}px, rgba(255,255,255,1) 0%, rgba(255,250,238,0.95) 18%, rgba(240,226,190,0.6) 38%, rgba(201,169,97,0.18) 58%, rgba(255,255,255,0) 75%)`;
            destello.style.transformOrigin = `${cx}px ${cy}px`;
            document.body.appendChild(destello);

            // Chispas doradas que suben desde el botón
            const chispas: HTMLElement[] = [];
            for (let i = 0; i < 18; i++) {
                const chispa = document.createElement('span');
                chispa.className = 'chispa-portada';
                chispa.style.left = `${cx}px`;
                chispa.style.top = `${cy}px`;
                document.body.appendChild(chispa);
                chispas.push(chispa);
            }

            // Contenido de la invitación: se oculta detrás de la portada
            // para revelarse con el destello (sin tocar el reproductor fijo)
            const contenido = document.querySelectorAll('#nombresflores > :not(#reproductor-fijo)');
            const reproductor = document.getElementById('reproductor-fijo');
            gsap.set(contenido, { opacity: 0, scale: 1.04, filter: 'blur(10px)' });
            if (reproductor) gsap.set(reproductor, { opacity: 0 });

            const tl = gsap.timeline({
                onComplete: () => {
                    portada?.remove();
                    destello.remove();
                    chispas.forEach((c) => c.remove());
                    gsap.set(contenido, { clearProps: 'transform,filter' });
                    ScrollTrigger.refresh();
                    console.log("✅ Portada cerrada");
                }
            });

            tl.fromTo(destello,
                { opacity: 0, scale: 0.3 },
                { opacity: 1, scale: 1.6, duration: 0.9, ease: "power2.out" }, 0)
              .to(chispas, {
                    x: () => gsap.utils.random(-140, 140),
                    y: () => gsap.utils.random(-260, -60),
                    scale: () => gsap.utils.random(0.6, 1.4),
                    opacity: 0,
                    duration: () => gsap.utils.random(1.1, 1.8),
                    ease: "power2.out",
                    stagger: 0.02
                }, 0)
              .to(portada, {
                    opacity: 0,
                    scale: 1.06,
                    filter: 'blur(6px)',
                    duration: 1,
                    ease: "power2.inOut"
                }, 0.15)
              .to(contenido, {
                    opacity: 1,
                    scale: 1,
                    filter: 'blur(0px)',
                    duration: 1.6,
                    ease: "power2.out",
                    stagger: 0.12
                }, 0.6)
              .to(destello, { opacity: 0, duration: 0.9, ease: "power1.inOut" }, 0.8)
              .to(reproductor, { opacity: 1, duration: 0.8, ease: "power2.out" }, 1.4);
        });

        console.log("✨ Animaciones de portada completadas!");
    });
</script>

<style>
    /* Fuentes personalizadas */
    @import url('https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap');

    .font-great-vibes {
        font-family: 'Great Vibes', cursive;
    }

    .font-charm {
        font-family: 'Great Vibes', 'Dancing Script', cursive;
    }

    /* Animaciones de entrada */
    @keyframes fade-in-down {
        from {
            opacity: 0;
            transform: translateY(-30px);
        }
        to {
            opacity: 0.9;
            transform: translateY(0);
        }
    }

    @keyframes fade-in-up {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 0.9;
            transform: translateY(0);
        }
    }

    .animate-fade-in-down {
        animation: fade-in-down 1s ease-out forwards;
    }

    .animate-fade-in-up {
        animation: fade-in-up 1s ease-out forwards;
        animation-delay: 0.2s;
    }

    /* Efecto hover en letras animadas */
    .letra-animada {
        transition: all 0.3s ease;
        will-change: transform, opacity, filter;
        position: relative;
    }

    .letra-animada:hover {
        transform: translateY(-3px) scale(1.1) !important;
        text-shadow: 0 0 15px rgba(139, 139, 139, 0.4) !important;
    }

    /* Prevenir scroll mientras está la portada */
    body:has(#portada-bienvenida:not(.cerrando)) {
        overflow: hidden;
    }

    /* Mientras se desvanece no debe atrapar toques */
    #portada-bienvenida.cerrando {
        pointer-events: none;
    }

    /* Destello y chispas: se crean por script, por eso :global */
    :global(.destello-portada) {
        position: fixed;
        inset: 0;
        z-index: 60;
        pointer-events: none;
        will-change: opacity, transform;
    }

    :global(.chispa-portada) {
        position: fixed;
        z-index: 61;
        width: 6px;
        height: 6px;
        margin: -3px 0 0 -3px;
        border-radius: 9999px;
        pointer-events: none;
        background: radial-gradient(circle, #fff 0%, #f3e3b5 40%, rgba(201, 169, 97, 0) 75%);
        box-shadow: 0 0 8px 2px rgba(201, 169, 97, 0.55);
    }

    /* Optimización de rendimiento */
    #marco-flores,
    .letra-animada {
        backface-visibility: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
</style>