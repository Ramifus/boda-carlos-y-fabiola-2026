---
// ComponenteCeremonia.astro
---

<section class="relative w-full py-4 px-6">
    
    <div class="max-w-md mx-auto">
        
        <!-- Tarjeta con borde redondeado -->
        <div
            id="ceremonia-card"
            class="relative border border-[#C9A961]/60 rounded-3xl p-8 sm:p-10 bg-white shadow-lg text-center overflow-hidden"
        >

            <!-- Borde interior fino (detalle elegante) -->
            <span class="pointer-events-none absolute inset-3 sm:inset-4 border border-[#C9A961]/25 rounded-2xl"></span>

            <div class="relative">

                <!-- Título "Ceremonia Religiosa y Recepción Social" -->
                <div id="titulo-ceremonia" class="mb-2">
                    <h3 class="font-great-vibes text-3xl sm:text-5xl md:text-6xl text-[#C9A961] leading-tight">
                        Ceremonia Religiosa<br />y Recepción Social
                    </h3>
                </div>

                <!-- Divisor ornamental -->
                <div class="flex items-center justify-center gap-3 mb-5">
                    <span class="block w-10 sm:w-14 h-px bg-gradient-to-r from-transparent to-[#C9A961]/70"></span>
                    <span class="text-[#C9A961] text-sm leading-none">&#10070;</span>
                    <span class="block w-10 sm:w-14 h-px bg-gradient-to-l from-transparent to-[#C9A961]/70"></span>
                </div>

                <!-- Icono de recepción -->
                <div id="icono-iglesia" class="mb-5 flex justify-center">
                    <div class="w-16 h-16 sm:w-20 sm:h-20 flex items-center justify-center">
                        <img
                            src="/imagenes/recepcion.png"
                            alt="Ceremonia y recepción"
                            class="w-full h-full object-contain"
                            style="filter: brightness(0) saturate(100%) invert(43%) sepia(8%) saturate(1044%) hue-rotate(49deg) brightness(96%) contrast(88%);"
                        />
                    </div>
                </div>

                <!-- Nombre del salón -->
                <div id="nombre-salon" class="mb-4">
                    <p class="font-serif text-lg sm:text-xl md:text-2xl text-[#C9A961] tracking-[0.1em] uppercase leading-snug">
                        Salón<br />“Fraternidad Jarubichis”
                    </p>
                </div>

                <!-- Dirección -->
                <div id="nombre-iglesia" class="mb-5">
                    <p class="text-[#6B6B6B] text-sm sm:text-base font-serif uppercase tracking-[0.12em] leading-relaxed">
                        Las Palmas 2,<br />Santa Cruz de la Sierra
                    </p>
                </div>

                <!-- Hora -->
                <div id="hora-ceremonia" class="mb-6">
                    <p class="text-xs sm:text-sm text-[#6B6B6B] uppercase tracking-[0.25em] font-serif mb-1">Hora</p>
                    <p class="text-[#C9A961] text-2xl sm:text-3xl font-serif tracking-wide">
                        16:30
                    </p>
                </div>

                <!-- Botón "VER UBICACIÓN" -->
                <div id="boton-ubicacion">
                    <a
                        href="https://maps.app.goo.gl/Kv3xgf2gEsK6EQqU8"
                        target="_blank"
                        class="group relative inline-block bg-[#6B7154] text-white px-9 py-3 rounded-lg text-sm sm:text-base font-serif uppercase tracking-[0.2em] hover:bg-[#5a5e45] transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5"
                    >
                        <span class="pointer-events-none absolute inset-1.5 rounded border border-white/30 transition-all duration-300 group-hover:inset-[7px]"></span>
                        <span class="relative">Ver ubicación</span>
                    </a>
                </div>

            </div>

        </div>

    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        console.log("⛪ Iniciando animaciones de ceremonia...");

        // ═══ TARJETA PRINCIPAL ═══
        gsap.fromTo(
            "#ceremonia-card",
            { opacity: 0, scale: 0.8, y: 50 },
            {
                opacity: 1,
                scale: 1,
                y: 0,
                duration: 1,
                ease: "back.out(1.4)",
                scrollTrigger: {
                    trigger: "#ceremonia-card",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                }
            }
        );

        // ═══ ICONO DE IGLESIA ═══
        gsap.fromTo(
            "#icono-iglesia",
            { opacity: 0, scale: 0.5, rotation: -10 },
            {
                opacity: 1,
                scale: 1,
                rotation: 0,
                duration: 0.8,
                ease: "back.out(1.7)",
                scrollTrigger: {
                    trigger: "#ceremonia-card",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                },
                delay: 0.3
            }
        );

        // ═══ TÍTULO "CEREMONIA RELIGIOSA" ═══
        gsap.fromTo(
            "#titulo-ceremonia",
            { opacity: 0, y: -20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#ceremonia-card",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                },
                delay: 0.6
            }
        );

        // ═══ HORA ═══
        gsap.fromTo(
            "#hora-ceremonia",
            { opacity: 0, scale: 0.7 },
            {
                opacity: 1,
                scale: 1,
                duration: 0.8,
                ease: "back.out(1.5)",
                scrollTrigger: {
                    trigger: "#ceremonia-card",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                },
                delay: 0.9
            }
        );

        // ═══ NOMBRE DE LA IGLESIA ═══
        gsap.fromTo(
            "#nombre-iglesia",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#ceremonia-card",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                },
                delay: 1.2
            }
        );

        // ═══ BOTÓN "VER UBICACIÓN" ═══
        gsap.fromTo(
            "#boton-ubicacion",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#ceremonia-card",
                    start: "top 80%",
                    toggleActions: "play none none reverse"
                },
                delay: 1.5
            }
        );

        console.log("✨ Animaciones de ceremonia completadas!");
    });
</script>

<style>
    /* Transiciones suaves en la tarjeta */
    #ceremonia-card {
        transition: all 0.3s ease;
    }

    #ceremonia-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }

    /* Efecto hover en el título */
    #titulo-ceremonia:hover {
        transform: scale(1.05);
        transition: transform 0.3s ease;
    }

    /* Animación del botón */
    #boton-ubicacion a:active {
        transform: scale(0.95);
    }
</style>